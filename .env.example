# ============================================================
# Life RPG — Root Environment Variables Template (.env.example)
# ============================================================

# --- Backend Configuration ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/liferpg
# For synchronous tools like Alembic:
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/liferpg

# Supabase Auth Secret (Used by FastAPI to verify JWT signature)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard-api-settings
SUPABASE_URL=https://your-project.supabase.co

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Server
PORT=8000
HOST=0.0.0.0

# --- Frontend Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
